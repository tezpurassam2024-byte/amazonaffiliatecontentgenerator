# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Convex Backend Deployment URL
# Deployed cloud endpoint:
VITE_CONVEX_URL="https://fantastic-koala-937.convex.cloud"

# Amazon Associates Settings
AMAZON_ASSOCIATE_TAG="affiliate-20"
AMAZON_API_KEY=""
AMAZON_SECRET_KEY=""

# Optional Analytics
GOOGLE_ANALYTICS_ID=""
